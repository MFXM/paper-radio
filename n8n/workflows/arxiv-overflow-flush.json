      "name": "Generate Briefing"
    },
    {
      "parameters": {
        "jsCode": "const fs = require('fs');\nconst path = require('path');\n\nconst overflowPath = path.join('/data', 'arxiv_overflow.json');\nlet overflowBuffer = [];\n\n// 1. Load papers from overflow\nif (fs.existsSync(overflowPath)) {\n  try {\n    overflowBuffer = JSON.parse(fs.readFileSync(overflowPath, 'utf8') || '[]');\n  } catch (e) {\n    console.error(\"Error reading overflow file:\", e);\n    overflowBuffer = [];\n  }\n}\n\n// 2. Clear the overflow file completely\ntry {\n  fs.writeFileSync(overflowPath, JSON.stringify([], null, 2), 'utf8');\n} catch (err) {\n  console.error(\"Failed to clear overflow buffer:\", err);\n}\n\n// 3. If no papers were found, stop execution cleanly\nif (!Array.isArray(overflowBuffer) || overflowBuffer.length === 0) {\n  return [];\n}\n\n// 4. Output each paper as an item for downstream podcast processing\nreturn overflowBuffer.map(paper => {\n  const id = paper.arxivId || paper.arxiv_id;\n  return {\n    json: {\n      arxivId: id,\n      arxiv_id: id,\n      url: paper.url || (id ? `https://arxiv.org/abs/${id}` : \"#\"),\n      debugTitle: paper.title || paper.debugTitle || \"Untitled Overflow Paper\",\n      authors: paper.authors || \"\"\n    }\n  };\n});"
      },
