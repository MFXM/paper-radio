# Copy to .env and fill in. Never commit .env.
# Values marked REQUIRED have no default. Generate secrets with:  openssl rand -hex 32

# ---------------------------------------------------------------- host
COMPOSE_PROJECT_NAME=paper-radio
TZ=Europe/Vienna
# UID/GID that owns ./data (run `id -u` / `id -g`)
PIPELINE_UID=1000
PIPELINE_GID=1000

# ---------------------------------------------------------------- secrets (REQUIRED)
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
QDRANT_API_KEY=

# ---------------------------------------------------------------- network
# Address/port n8n is published on. Mattermost and the devices that open the
# upload and curation forms must be able to reach WEBHOOK_URL.
N8N_BIND=127.0.0.1
N8N_PUBLISH_PORT=5678
WEBHOOK_URL=http://localhost:5678/
# Set to true when n8n is served over HTTPS
N8N_SECURE_COOKIE=false

# Podcast feed (nginx). PODCAST_PUBLIC_URL is the base URL your podcast app uses.
FEED_BIND=127.0.0.1
FEED_PORT=8080
PODCAST_PUBLIC_URL=http://localhost:8080
PODCAST_TITLE="Research Radio"
PODCAST_DESCRIPTION="Automated audio summaries of research papers"
PODCAST_LANGUAGE=en-gb

# ---------------------------------------------------------------- Mattermost (REQUIRED)
MATTERMOST_URL=https://chat.example.org
# Bot account access token (System Console > Integrations > Bot Accounts)
MATTERMOST_BOT_TOKEN=
# Channel the bot posts into (channel name > View Info shows the ID)
MATTERMOST_CHANNEL_ID=

# ---------------------------------------------------------------- Zotero (REQUIRED)
# users = personal library (numeric user ID), groups = group library (group ID)
ZOTERO_LIBRARY_TYPE=users
ZOTERO_LIBRARY_ID=
# Collection new papers are filed into; also used for de-duplication
ZOTERO_COLLECTION_KEY=
ZOTERO_API_KEY=

# ---------------------------------------------------------------- discovery
ARXIV_CATEGORIES=quant-ph,cs.LG
SCIRATE_CATEGORY=quant-ph
SCIRATE_MIN_SCITES=10
SCOUT_MIN_SCORE=0.75
SCOUT_MAX_CANDIDATES=100
OVERFLOW_ALERT_THRESHOLD=25
# arXiv asks API clients to identify themselves; include a contact address
HTTP_USER_AGENT="paper-radio/1.0 (mailto:you@example.org)"
# Fed into the curator prompt
RESEARCH_EXPERTISE="quantum computing and machine learning"
RESEARCH_FOCUS="quantum algorithms, quantum machine learning, variational circuits"
RESEARCH_EXCLUDE="pure condensed-matter physics, high-energy physics"

# ---------------------------------------------------------------- LLM providers
# Scout curator: any OpenAI-compatible endpoint (REQUIRED)
SCOUT_LLM_BASE_URL=https://api.openai.com/v1
SCOUT_LLM_API_KEY=
SCOUT_MODEL=
# Fallback for the curator via OpenRouter (optional)
OPENROUTER_API_KEY=
SCOUT_FALLBACK_MODEL=

# Script writing: any Ollama-compatible chat endpoint (REQUIRED)
LLM_GATEWAY_URL=http://ollama:11434
LLM_GATEWAY_API_KEY=
LLM_MODEL_BRIEFING=
# Optional per-step overrides (default: LLM_MODEL_BRIEFING)
LLM_MODEL_TLDR=
LLM_MODEL_BREAKDOWN=
LLM_MODEL_OUTLINE=
LLM_MODEL_CHAPTER=
LLM_MODEL_LECTURE_PLAN=
LLM_MODEL_LECTURE_CHAPTER=
LLM_MODEL_EXPLAIN=

# Google Gemini for briefing scripts and TL;DRs (optional; falls back to the gateway)
GEMINI_API_KEY=
GEMINI_SCRIPT_MODEL=models/gemini-flash-latest
GEMINI_TLDR_MODEL=models/gemini-flash-lite-latest

# Local embeddings (bootstrap.sh pulls this into the bundled Ollama)
EMBEDDING_MODEL=nomic-embed-text

# ---------------------------------------------------------------- TTS
TTS_VOICE=bm_george
TTS_SPEED=1.0

# ---------------------------------------------------------------- n8n API (optional)
# Enables the "Retry" button on error cards. Create the key in n8n under
# Settings > n8n API after the first login, then re-run ./scripts/bootstrap.sh
N8N_API_KEY=
